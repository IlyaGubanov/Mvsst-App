# =====================================================================
#  Настройки сервера. КАК ПОЛЬЗОВАТЬСЯ:
#  1. Скопируйте этот файл в .env  (Windows: copy .env.example .env ; Linux: cp .env.example .env)
#  2. Впишите свои значения в .env.
#  Файл .env содержит пароли — его НЕЛЬЗЯ публиковать и отправлять в Git (он в .gitignore).
#  Строки, начинающиеся с #, — комментарии.
# =====================================================================

# Режим: development — разработка на своём ПК; production — рабочий сервер
NODE_ENV=development

# Порт, на котором слушает сервер. В production к нему обращается Nginx (см. docs/03-deployment.md)
PORT=3000

# Часовой пояс: от него зависит «план на сегодня»
TZ=Europe/Moscow

# ---------- База данных MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mvs_dashboard
DB_USER=mvs_app
DB_PASSWORD=впишите_пароль_пользователя_mvs_app
# Сколько одновременных подключений к базе держать (10 — с запасом для организации)
DB_CONNECTION_LIMIT=10

# ---------- Сеансы входа ----------
# Секрет для подписи cookie. Длинная случайная строка, минимум 32 символа.
# Получить: в Linux — openssl rand -hex 32 ; в PowerShell — -join ((48..57)+(97..102) | Get-Random -Count 32 | % {[char]$_})
# Если поменять секрет, все пользователи будут разлогинены.
SESSION_SECRET=замените_на_длинную_случайную_строку_минимум_32_символа
# Сколько часов действует вход без активности
SESSION_HOURS=12

# Cookie только по HTTPS. В production — true (по умолчанию). false — только если сервер в внутренней сети без HTTPS.
# COOKIE_SECURE=true

# Сервер стоит за Nginx (production) — true, чтобы правильно определять IP пользователя
TRUST_PROXY=false

# Отдавать собранный интерфейс (client/dist) самим Node.js — для варианта без Nginx (Windows Server)
SERVE_CLIENT=false
